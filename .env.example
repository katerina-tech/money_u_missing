# ============================================================================
# MONEY YOU'RE MISSING - environment
# Copy to `.env` and fill in. `.env` is gitignored and never logged.
#
# NOTHING here is required to run the product. With an empty file the app
# starts, serves demo + curated opportunities, runs every deterministic
# engine, and degrades LLM/live-search features with an honest message.
# See docs/ARCHITECTURE.md, "Degradation matrix".
# ============================================================================

# ---------------------------------------------------------------- database
# Postgres is the production target (pgvector for RAG). Leave unset and the
# app falls back to a local SQLite file with numpy vector search, so `make
# dev`, `make test` and the demo work with zero external services.
#   Supabase example (choose an EU region - see docs/GDPR_DATA_MAP.md):
#   MYM_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# MYM_DATABASE_URL=

# ------------------------------------------------------------------- auth
# Signing key for session tokens. MUST be set in production; in development a
# per-process ephemeral key is generated (sessions die on restart).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# MYM_JWT_SECRET=
# MYM_ACCESS_TOKEN_TTL_MINUTES=30
# MYM_REFRESH_TOKEN_TTL_DAYS=14

# Optional: verify Supabase Auth tokens instead of issuing our own.
# MYM_AUTH_BACKEND=local          # local | supabase
# MYM_SUPABASE_URL=
# MYM_SUPABASE_JWT_SECRET=

# --------------------------------------------------------------------- llm
# Used for: CV extraction, search-planning, match explanation, draft writing,
# RAG answer composition. NEVER for scores, money, or legal facts.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# MYM_LLM_PROVIDER=anthropic      # anthropic | openrouter | scripted | none
# MYM_LLM_MODEL=claude-opus-5
# MYM_LLM_CLASSIFIER_MODEL=claude-haiku-4-5
# MYM_LLM_TIMEOUT_SECONDS=60
# MYM_LLM_MAX_RETRIES=2
# MYM_LLM_MAX_TOKENS=2048

# ------------------------------------------------------------ live search
# Optional. Without a key, discovery uses curated + demo sources only and the
# UI says so. Provider is pluggable - see app/search/.
# MYM_SEARCH_PROVIDER=none        # none | tavily | brave | serper
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=

# ---------------------------------------------------------------- retrieval
# "local" embeds on-device with fastembed (no API cost, no network after the
# first model download). "openai" uses a hosted embedding endpoint.
# MYM_EMBEDDING_BACKEND=local     # local | openai
# MYM_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------ runtime
# MYM_LOG_LEVEL=INFO
# MYM_LOG_FORMAT=console          # json | console
# MYM_CORS_ORIGINS=http://localhost:3000
# MYM_DEMO_MODE_ENABLED=true
# MYM_PAYMENTS_ENABLED=false
